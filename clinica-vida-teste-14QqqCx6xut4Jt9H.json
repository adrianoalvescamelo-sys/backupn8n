usuário pedir para falar com um humano, atendente, ou suporte, RESPONDA APENAS E EXATAMENTE COM A MENSAGEM:\nneeds_human\n- Só fale \"needs_human\" se ele pedir humano explicitamente! Caso contrário atenda normalmente.\n- SEJA CORTÊS, responda de forma humanizada e foque na dor dele.\n- Finalize buscando um agendamento se fizer sentido."}},"id":"ai-agent-reverted","name":"AI Agent","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[576,80]}],"connections":{"Edit Fields":{"main":[[{"node":"If","type":"main","index":0}]]},"If":{"main":[[{"node":"No Operation, do nothing","type":"main","index":0}],[{"node":"Tipos de Mensagens","type":"main","index":0}]]},"Tipos de Mensagens":{"main":[[{"node":"msg-conversation","type":"main","index":0}],[{"node":"msg-ephemeral","type":"main","index":0}],[{"node":"msg-extended","type":"main","index":0}],[{"node":"Convert to File","type":"main","index":0}],[{"node":"Convert Image","type":"main","index":0}],[{"node":"Unsupported Message","type":"main","index":0}],[{"node":"Unsupported Message","type":"main","index":0}]]},"msg-conversation":{"main":[[{"node":"AI Agent","type":"main","index":0}]]},"msg-ephemeral":{"main":[[{"node":"AI Agent","type":"main","index":0}]]},"msg-extended":{"main":[[{"node":"AI Agent","type":"main","index":0}]]},"OpenAI Chat Model":{"ai_languageModel":[[{"node":"AI Agent","type":"ai_languageModel","index":0}]]},"Simple Memory":{"ai_memory":[[{"node":"AI Agent","type":"ai_memory","index":0}]]},"Edit Fields1":{"main":[[{"node":"HTTP Request1","type":"main","index":0}]]},"final":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"Webhook":{"main":[[{"node":"Edit Fields","type":"main","index":0}]]},"Convert to File":{"main":[[{"node":"Transcribe a recording","type":"main","index":0}]]},"Transcribe a recording":{"main":[[{"node":"AI Agent","type":"main","index":0}]]},"Convert Image":{"main":[[{"node":"AI Agent","type":"main","index":0}]]},"Unsupported Message":{"main":[[{"node":"final","ty