c3-5e1d-40a2-98a3-214b57ae3920"},{"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"il1","leftValue":"={{ $json.body.action }}","rightValue":"login","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"name":"Is Login?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-768,1200],"id":"8874ac51-eaa6-460e-b2c7-467e8d086a25"},{"parameters":{"operation":"executeQuery","query":"SELECT id, username, nome, password_hash FROM financeiro.dashboard_users WHERE username = '{{ $('Sanitize POST Params').first().json.body.username }}' AND ativo = true LIMIT 1;","options":{}},"name":"PG Login","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-576,1360],"alwaysOutputData":true,"id":"9a0bb74a-0930-471b-9893-9677c72a15b5"},{"parameters":{"jsCode":"const crypto = require('crypto');\nconst user = $input.first().json;\nconst body = $('Sanitize POST Params').first().json.body;\nconst password = String(body.password || '');\n\nif (!user || !user.id) {\n  return [{ json: { loginOk: false, error: 'Usuário não encontrado' } }];\n}\n\nconst hash = crypto.createHash('sha256').update(password).digest('hex');\nif (hash !== user.password_hash) {\n  return [{ json: { loginOk: false, error: 'Senha incorreta' } }];\n}\n\nconst token = crypto.randomBytes(32).toString('hex');\nreturn [{ json: { loginOk: true, userId: user.id, username: user.username, nome: user.nome, token } }];"},"name":"Validate Login","type":"n8n-nodes-base.code","typeVersion":2,"position":[-368,1360],"id":"870845b3-9caf-446d-aa93-4e3a1c3293a4"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"lok1","leftValue":"={{ $json.loginOk }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"},"options":{}},"name":"Login OK?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-160,1360],"id":"74d