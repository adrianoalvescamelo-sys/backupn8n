eceber_pendente, COALESCE(SUM(CASE WHEN tipo IN ('a_receber','recebido') THEN valor END), 0) - COALESCE(SUM(CASE WHEN tipo IN ('a_pagar','pago') THEN valor END), 0) as saldo_previsto FROM financeiro.lancamentos WHERE \" + where + \";\";\nreturn [{ json: { sql } }];"},"name":"Build SQL Resumo","type":"n8n-nodes-base.code","typeVersion":2,"position":[0,352],"id":"1d1a564e-f0d1-40d4-9bcc-2a8a6b32108b"},{"parameters":{"operation":"executeQuery","query":"{{ $json.sql }}","options":{}},"name":"PG Resumo","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[224,352],"id":"5b8b4902-e539-4596-b157-eb7acab2c2f2","onError":"continueRegularOutput"},{"parameters":{"jsCode":"const items = $input.all().map(i => i.json);\nconst r = items[0] && items[0].total_despesas !== undefined ? items[0] : { total_despesas: 0, total_receitas: 0, a_pagar_pendente: 0, a_receber_pendente: 0, saldo_previsto: 0 };\nreturn [{ json: r }];"},"name":"Wrap Resumo","type":"n8n-nodes-base.code","typeVersion":2,"position":[448,352],"id":"41007497-876a-41b2-bf6e-f37c81817248"},{"parameters":{"options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Access-Control-Allow-Origin","value":"*"}]}}},"name":"Respond Resumo","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[672,352],"id":"38ff7eff-10ac-4961-b10a-3bd3bb5fe9a4"},{"parameters":{"operation":"executeQuery","query":"SELECT COALESCE(json_agg(sub), '[]'::json) as data FROM (SELECT id, nome, tipo FROM financeiro.categorias WHERE ativo = true ORDER BY tipo, nome) sub;","options":{}},"name":"PG Categorias","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[0,512],"id":"bd73556a-e4c2-4aae-b846-6036814da2c1","onError":"continueRegularOutput"},{"parameters":{"jsCode":"const result = $input.first().json;\nconst items = result.data || [];\nreturn [{ json: { __body: JSON.stringify(items) } }];"},"name":"Wrap Categorias","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,512],"id":"37d97c3e-4883-4d2f-8cd